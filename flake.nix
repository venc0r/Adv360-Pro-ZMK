{
  description = "venc0r Kinesis Advantage 360 Pro ZMK firmware";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

    zmk-nix = {
      url = "github:lilyinstarlight/zmk-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, zmk-nix }:
    let
      lib = nixpkgs.lib;
      forAllSystems = lib.genAttrs (lib.attrNames zmk-nix.packages);

      # The custom adv360 board lives under config/boards/arm/adv360 and includes a
      # bare "Kconfig" file plus *.yaml, so those suffixes are added on top of the
      # upstream template list.
      src = lib.sourceFilesBySuffices self [
        ".board" ".cmake" ".conf" ".defconfig" ".dts" ".dtsi" ".h"
        ".json" ".keymap" ".overlay" ".shield" ".yml" ".yaml"
        "Kconfig" "_defconfig"
      ];

      # config/version.dtsi is committed empty and normally regenerated by
      # bin/get_version_local.sh at build time, but the keymap references
      # &macro_ver from it. Recreate a valid macro here (typing the flake revision)
      # so the build is self-contained and reproducible.
      version = self.shortRev or self.dirtyShortRev or "dev";
      toBindings = str:
        let
          mapChar = c:
            if lib.hasInfix c "0123456789" then "<&kp N${c}>"
            else if c == "-" then "<&kp MINUS>"
            else if c == "." then "<&kp DOT>"
            else if (lib.toUpper c) != (lib.toLower c) then "<&kp ${lib.toUpper c}>"
            else null;
          parts = lib.filter (x: x != null) (map mapChar (lib.stringToCharacters str));
        in
        lib.concatStringsSep ", " (parts ++ [ "<&kp RET>" ]);
      versionDtsi = ''
        #define VERSION_MACRO
        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = ${toBindings version};
        };
      '';

      meta = {
        description = "venc0r Advantage 360 Pro firmware";
        license = lib.licenses.mit;
        platforms = lib.platforms.all;
      };

      # Run `nix run .#update` after changing config/west.yml to refresh this.
      zephyrDepsHash = "sha256-0tNjgMiepoGr/eGPvxSyRaKTekoZ8KqAAoLG3HAPKq8=";
    in
    {
      packages = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          zmk = zmk-nix.legacyPackages.${system};
          zmkPkgs = zmk-nix.packages.${system};

          adv360 = zmk.buildSplitKeyboard {
            name = "adv360";
            inherit src zephyrDepsHash meta;
            board = "adv360_%PART%";
            # Studio runs on the central (left) half only, matching bin/build.sh.
            enableZmkStudio = true;
            postPatch = ''
              cat > config/version.dtsi <<'VERSION_EOF'
              ${versionDtsi}VERSION_EOF
            '';
          };

          firmware = pkgs.runCommand "venc0r-adv360-firmware" { } ''
            mkdir -p $out
            cp ${adv360}/zmk_left.uf2  $out/adv360_left.uf2
            cp ${adv360}/zmk_right.uf2 $out/adv360_right.uf2
          '';
        in
        {
          inherit adv360 firmware;
          default = firmware;
          flash = zmkPkgs.flash.override { firmware = adv360; };
          update = zmkPkgs.update;
        });

      devShells = forAllSystems (system: {
        default = zmk-nix.devShells.${system}.default;
      });
    };
}
